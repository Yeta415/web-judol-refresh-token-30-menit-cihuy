# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000

# ============================================================
# TARGET SITE & CREDENTIALS
# ============================================================
TARGET_URL=https://vhjgakh.com
ACCOUNT_USERNAME=your_username_here
ACCOUNT_PASSWORD=your_password_here

# ============================================================
# REFRESH INTERVAL (in minutes, default: 30)
# ============================================================
REFRESH_INTERVAL_MINUTES=30

# ============================================================
# PUPPETEER CONFIGURATION
# ============================================================
# Set to 'false' to show browser window for debugging, 'true' for headless background mode
HEADLESS=true

# Optional HTTP/SOCKS5 proxy if target site is blocked by ISP (e.g. http://127.0.0.1:8080)
# PROXY_SERVER=

# Navigation timeout in milliseconds (default: 60000)
NAVIGATION_TIMEOUT=60000

# ============================================================
# CUSTOM FORM SELECTORS (Leave empty for smart auto-detect)
# ============================================================
# SELECTOR_USERNAME=input[name="username"], input[name="user"], #username, #txtUser
# SELECTOR_PASSWORD=input[name="password"], input[type="password"], #password, #txtPass
# SELECTOR_SUBMIT=button[type="submit"], input[type="submit"], .btn-login, #btnLogin
